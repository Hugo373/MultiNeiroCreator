# 必填：JWT 签名密钥（缺失时服务拒绝启动）
SECRET_KEY=change-me-to-a-long-random-string

# 对话模型：智谱 GLM-4-Flash
API_KEY=

# Embedding：SiliconFlow BGE-M3
SILICONFLOW_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_API_URL=https://api.siliconflow.cn/v1/embeddings
RAG_COLLECTION_NAME=documents_siliconflow_bge_m3
RAG_DISTANCE_THRESHOLD=1.10

# Redis（限流 / 登录验证码）
REDIS_URL=redis://localhost:6379/0

# 注册验证码 SMTP（国内环境推荐 QQ 邮箱 465 SSL）
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=

# CORS：允许的前端来源，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 上传与正文限制
UPLOAD_MAX_FILE_MB=30
UPLOAD_DAILY_TOTAL_MB=100
BODY_MAX_MB=32
